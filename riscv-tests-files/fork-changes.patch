+                       const short *verify) {
+  int i;
+  // Unrolled for faster verification
+  for (i = 0; i < n / 2 * 2; i += 2) {
+    int t0 = test[i], t1 = test[i + 1];
+    int v0 = verify[i], v1 = verify[i + 1];
+    if (t0 != v0)
+      return i + 1;
+    if (t1 != v1)
+      return i + 2;
+  }
+  if (n % 2 != 0 && test[n - 1] != verify[n - 1])
+    return n;
+  return 0;
+}
