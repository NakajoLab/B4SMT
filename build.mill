//| mill-version: 1.3.1
//| mill-jvm-version: system
package build

import mill._
import mill.scalalib._

trait ChiselModule extends SbtModule {
  def scalaVersion = "2.13.18"
  def chiselVersion = "7.16.0"
  override def scalacOptions = Seq(
    "-language:reflectiveCalls",
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Ymacro-annotations",
  )
  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion",
  )
}

object b4smt_formal extends ChiselModule {
  override def moduleDir = super.moduleDir / os.up / "chisel-formal"
  override def mvnDeps =
    super.mvnDeps() ++ Seq(mvn"org.scalatest::scalatest:3.2.18")
}

object b4smt_pext extends ChiselModule {
  override def moduleDir = super.moduleDir / os.up / "pext"
  override def moduleDeps = Seq(b4smt_formal)
}

object b4smt extends ChiselModule {
  override def mainClass = Some("b4smt.B4SMTCore")
  override def moduleDeps = Seq(b4smt_formal, b4smt_pext)

  object test extends SbtTests with TestModule.ScalaTest {
    override def testParallelism = Task { false }
    override def testSandboxWorkingDir = false
    override def mvnDeps = Seq(mvn"org.scalatest::scalatest:3.2.18")
  }
}
